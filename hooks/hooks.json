{
  "description": "Observe Codex lifecycle events and update the local Discord presence daemon.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/src/cli.mjs\" hook", "commandWindows": "node -e \"require('node:child_process').spawnSync(process.execPath,[require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'src','cli.mjs'),'hook'],{stdio:'inherit',windowsHide:true})\"", "timeout": 3 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/src/cli.mjs\" hook", "commandWindows": "node -e \"require('node:child_process').spawnSync(process.execPath,[require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'src','cli.mjs'),'hook'],{stdio:'inherit',windowsHide:true})\"", "timeout": 3 }] }],
    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/src/cli.mjs\" hook", "commandWindows": "node -e \"require('node:child_process').spawnSync(process.execPath,[require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'src','cli.mjs'),'hook'],{stdio:'inherit',windowsHide:true})\"", "timeout": 3 }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/src/cli.mjs\" hook", "commandWindows": "node -e \"require('node:child_process').spawnSync(process.execPath,[require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'src','cli.mjs'),'hook'],{stdio:'inherit',windowsHide:true})\"", "timeout": 3 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/src/cli.mjs\" hook", "commandWindows": "node -e \"require('node:child_process').spawnSync(process.execPath,[require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'src','cli.mjs'),'hook'],{stdio:'inherit',windowsHide:true})\"", "timeout": 3 }] }],
    "Interrupt": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/src/cli.mjs\" hook", "commandWindows": "node -e \"require('node:child_process').spawnSync(process.execPath,[require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'src','cli.mjs'),'hook'],{stdio:'inherit',windowsHide:true})\"", "timeout": 3 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/src/cli.mjs\" hook", "commandWindows": "node -e \"require('node:child_process').spawnSync(process.execPath,[require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'src','cli.mjs'),'hook'],{stdio:'inherit',windowsHide:true})\"", "timeout": 3 }] }]
  }
}
